# --- Secrets ---
.env
.env.local
.streamlit/secrets.toml

# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.lock

# --- Test / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Runtime state: regenerated by the app, never committed ---
# Uploaded sheets land in datasets/ as Parquet and can reach gigabytes, so
# they are deliberately excluded rather than merely untracked.
datasets/
memories/
temp_mem/
rag_store/
.fastembed/
*.sqlite
*.db
*.parquet

# --- Local run logs ---
# The dev servers are usually started with output redirected to a file;
# those are per-run and worthless to anyone else.
*.log

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
