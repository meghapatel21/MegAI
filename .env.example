# MegAI - environment configuration
# Copy to .env and fill in GROQ_API_KEY. Every value below has a working
# default in app/config.py, so the only required entry is the API key.
# Project: github.com/meghapatel21/agentic-bi-natural-language-querying

# --- LLM (required for natural-language analysis) ---
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"

# --- Backend URL used by the Streamlit frontend ---
BACKEND_URL="http://localhost:8000"

# --- Dataset storage ---
# "local" writes Parquet under DATASET_DIR.
# "azure" uses Blob Storage - required if you scale past one instance,
# since App Service / Container Apps replicas do not share local disk.
STORAGE_BACKEND="local"
DATASET_DIR="./datasets"
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=..."
# AZURE_STORAGE_CONTAINER="agentic-bi-datasets"

# --- RAG ---
# "fastembed" = local ONNX model, free, no key (default)
# "hashing"   = no model at all, zero downloads, weaker retrieval
# "azure"     = Azure OpenAI embeddings (needs the two vars below)
EMBEDDING_BACKEND="fastembed"
FASTEMBED_MODEL="BAAI/bge-small-en-v1.5"
RAG_DIR="./rag_store"
RAG_TOP_K=3
RAG_MIN_SCORE=0.35
RAG_QUERY_MEMORY_ENABLED=true
RAG_GLOSSARY_ENABLED=true
# AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
# AZURE_OPENAI_API_KEY="..."
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# --- Optional agents (each is one extra LLM call per question) ---
CLARIFY_ENABLED=true
PLANNER_ENABLED=true
CRITIC_ENABLED=true
INSIGHT_ENABLED=true
MAX_PLAN_STEPS=4

# --- Limits ---
# The whole pipeline loads a sheet fully into memory to run generated pandas
# against it, so these are bounded by the deployment's RAM, not by the code -
# raising them without raising the container's memory just moves an OOM from
# upload time to the first question asked. See AZURE_DEPLOY.md.
MAX_UPLOAD_BYTES=524288000
MAX_ROWS_PER_SHEET=6000000

# Above this many rows, the upload briefing's descriptive passes (column roles,
# cardinality, quality checks, correlations) run on a random sample rather than
# every row - this is the single biggest cost in a large upload. Row counts,
# totals, breakdowns and the date range are always exact. 0 = profile every row.
PROFILE_SAMPLE_ROWS=250000
MAX_RESULT_ROWS=5000
MAX_ANALYSIS_ATTEMPTS=3
MAX_GLOSSARY_BYTES=2097152

# --- Zip uploads ---
# A zip lets a large export travel compressed; each file inside becomes a
# sheet, same as an Excel tab. MAX_ZIP_UNCOMPRESSED_BYTES bounds what actually
# gets decompressed regardless of what the zip's own size metadata claims.
MAX_ZIP_UNCOMPRESSED_BYTES=1610612736
MAX_ZIP_MEMBERS=30
